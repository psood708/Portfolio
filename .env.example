# Required for live answers in the "Ask my portfolio anything…" bar.
# Without it the bar still works — it falls back to the canned answers in
# lib/ask.ts and labels itself "canned response".
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Rate limiting for the public /api/ask endpoint. Optional locally, REQUIRED for
# any public deployment — without these the endpoint is unmetered and anyone who
# finds it can spend your Anthropic credit.
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
